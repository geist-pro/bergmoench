<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sync with a self-hosted Anki sync server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Study reminder (asked for only when the person turns reminders on). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arm the reminder after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:label="Bergmönch" android:theme="@style/Theme.Kartei" android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:windowSoftInputMode="adjustResize" android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait" />
        <!-- Two launcher entries, one per app icon; exactly one is enabled (AppIconSwitch). GEIST is the default. -->
        <activity-alias android:name=".LauncherGeist" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="true" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherGruvbox" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_gruvbox" android:roundIcon="@mipmap/ic_launcher_gruvbox_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver android:name=".reach.ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".reach.KarteiWidget" android:exported="false" android:label="Bergmönch">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/kartei_widget" />
        </receiver>
    </application>
</manifest>
